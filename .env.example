# ==============================================================================
# Kisan Mitra - Environment Variables Template
# Copy this file to .env.local and fill in real production credentials.
# Never commit real credentials to version control.
# ==============================================================================

# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Demo Mode (Optional: set to 'true' to show Quick Demo Access on Mandi portal)
NEXT_PUBLIC_DEMO_MODE=false

# Google Apps Script Support / Contact Submissions (Required for /api/contact)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec

# Fast2SMS Gateway (Optional / Server-only: used if direct SMS sending is enabled)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Kisan Mitra Sahayak AI & Live Mandi Prices
DATA_GOV_API_KEY=your_data_gov_in_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEV_MODE=false
MARKET_DATA_STATE=Maharashtra

